# Copy this file to ".env" (same folder) and fill in your keys.

# -- Anthropic (Claude) -------------------------------------------------------
# Required. Athena is Claude-only for chat.
# Models: claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Default chat model. Switch anytime with /model <name> or the UI dropdown.
DEFAULT_MODEL=claude-opus-5

# -- OpenAI (embeddings only) -------------------------------------------------
# Optional. Used ONLY for embeddings (semantic memory), never for chat.
# Leave blank to fall back to BM25 keyword recall.
OPENAI_API_KEY=

# Leave as-is unless routing through an OpenAI-compatible proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# -- NVIDIA NIM ---------------------------------------------------------------
# Optional: embeddings via NVIDIA-hosted models.
# Get a key at: https://build.nvidia.com
NVIDIA_API_KEY=

# -- Voyage AI ----------------------------------------------------------------
# Optional: semantic memory / recall (best for code + technical content)
# Recommended over OpenAI embeddings for Athena's use case.
# Get a key at: https://dash.voyageai.com
# Priority order for embeddings: Voyage AI -> NVIDIA NIM -> OpenAI
VOYAGE_API_KEY=

# -- Brave Search -------------------------------------------------------------
# Required for: web_search tool
# Get a key at: https://brave.com/search/api/
BRAVE_API_KEY=

# -- Local LLM (cheap jobs + credit fallback; not used when the network is down)
# GPU layers to offload to a discrete GPU via Vulkan (0 = pure CPU, safest).
# With a 4 GB GPU and an 8B Q4 model, ~20 is a good start.
LOCAL_GPU_LAYERS=0

# true  = load model fully into RAM (--no-mmap; required for FAT32 USB drives)
# false = memory-map weights from disk (faster start, elastic RAM; NTFS SSD only)
LOCAL_NO_MMAP=true

# -- Behaviour ----------------------------------------------------------------
# false = Athena asks before running shell commands or writing files (recommended)
# true  = Athena acts without asking. Only on machines you fully trust.
AUTO_APPROVE=false

# What she calls herself.
AGENT_NAME=Athena

# on  = when the cloud AI is unreachable, Athena diagnoses the network and applies the
#       safe fixes on her own (adapter restart, DHCP renew, DNS flush). Never resets the
#       network stack -- that one needs your approval and a reboot.
# off = report the problem only.
NET_TRIAGE=on

# How long (ms) a cloud model may go silent before Athena gives up on that request and
# tries the next model. Local models get 5x this. Minimum 15000.
API_STALL_MS=120000
